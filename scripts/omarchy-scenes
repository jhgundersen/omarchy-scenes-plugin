#!/usr/bin/env bash
set -euo pipefail

CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"
RUNTIME_HOME="${XDG_RUNTIME_DIR:-/tmp}"
CONFIG_FILE="${OMARCHY_SCENES_CONFIG:-$CONFIG_HOME/omarchy/scenes.json}"
STATE_FILE="${OMARCHY_SCENES_STATE:-$STATE_HOME/omarchy-scenes/state.json}"
LOCK_FILE="${OMARCHY_SCENES_LOCK:-$RUNTIME_HOME/omarchy-scenes.lock}"

HYPRCTL_BIN="${OMARCHY_SCENES_HYPRCTL:-hyprctl}"
PACTL_BIN="${OMARCHY_SCENES_PACTL:-pactl}"
OMARCHY_BIN="${OMARCHY_SCENES_OMARCHY:-omarchy}"
AUDIO_SET_BIN="${OMARCHY_SCENES_AUDIO_SET:-omarchy-audio-output-set-default}"
NOTIFY_BIN="${OMARCHY_SCENES_NOTIFY:-omarchy-notification-send}"

EMPTY_CONFIG='{"version":1,"scenes":[]}'

usage() {
  cat <<'USAGE'
Usage: omarchy-scenes <command> [arguments]

Commands:
  status                     Print scenes, devices, themes, and live state as JSON
  save <json>                Create or update one scene
  delete <scene-id>          Delete a scene
  apply <scene-id>           Apply one scene
  next                       Apply the next scene in creation order
USAGE
}

notify() {
  local message="$1"
  "$NOTIFY_BIN" -g '󰌨' "Scenes" "$message" >/dev/null 2>&1 || true
}

slugify() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed -E 's/<[^>]+>//g; s/[[:space:]]+/-/g'
}

read_config() {
  local raw="$EMPTY_CONFIG"
  if [[ -f $CONFIG_FILE ]]; then
    raw=$(<"$CONFIG_FILE")
  fi
  jq -ce '
    select(.version == 1 and (.scenes | type) == "array")
    | {version: 1, scenes: .scenes}
  ' <<<"$raw" 2>/dev/null || {
    echo "Scenes configuration is invalid: $CONFIG_FILE" >&2
    return 1
  }
}

write_json_atomic() {
  local target="$1"
  local payload="$2"
  local target_dir tmp
  target_dir=$(dirname "$target")
  mkdir -p "$target_dir"
  tmp=$(mktemp "$target_dir/.scenes.XXXXXX")
  chmod 600 "$tmp"
  printf '%s\n' "$payload" >"$tmp"
  mv "$tmp" "$target"
}

with_lock() {
  mkdir -p "$(dirname "$LOCK_FILE")"
  exec 9>"$LOCK_FILE"
  if ! flock -n 9; then
    notify "Another scene change is already running"
    echo "another scene change is already running" >&2
    exit 75
  fi
}

monitor_inventory() {
  "$HYPRCTL_BIN" monitors all -j | jq -ce '[.[] | {
    connector: .name,
    description: (.description // .name),
    enabled: ((.disabled // false) | not),
    focused: (.focused // false),
    x: (.x // -1), y: (.y // -1),
    width: (.width // 0), height: (.height // 0),
    refreshRate: (.refreshRate // 0),
    scale: (.scale // 1),
    transform: (.transform // 0),
    availableModes: (.availableModes // [])
  }]'
}

sink_inventory() {
  "$PACTL_BIN" -f json list sinks 2>/dev/null | jq -ce '
    def friendly_label:
      tostring
      | sub("^sof-soundwire[[:space:]]+"; ""; "i")
      | sub("^built-?in audio[[:space:]]+"; ""; "i")
      | sub("[[:space:]]+Output$"; ""; "i")
      | sub("[[:space:]]+Input$"; ""; "i");
    [.[] | {
      name: .name,
      label: ((.properties."node.nick" // .properties."device.profile.description" // .description // .properties."node.description" // .name) | friendly_label),
      id: (.index | tostring)
    }]'
}

theme_inventory() {
  "$OMARCHY_BIN" theme list 2>/dev/null | jq -Rsc 'split("\n") | map(select(length > 0))'
}

current_theme() {
  "$OMARCHY_BIN" theme current 2>/dev/null | head -n1 || true
}

current_sink() {
  "$PACTL_BIN" get-default-sink 2>/dev/null || true
}

read_last_scene() {
  if [[ -f $STATE_FILE ]]; then
    jq -r '.lastSceneId // ""' "$STATE_FILE" 2>/dev/null || true
  fi
}

status_command() {
  local config monitors sinks themes theme sink last
  config=$(read_config)
  monitors=$(monitor_inventory)
  sinks=$(sink_inventory)
  themes=$(theme_inventory)
  theme=$(current_theme)
  sink=$(current_sink)
  last=$(read_last_scene)

  jq -cn \
    --argjson config "$config" \
    --argjson monitors "$monitors" \
    --argjson sinks "$sinks" \
    --argjson themes "$themes" \
    --arg theme "$theme" \
    --arg sink "$sink" \
    --arg last "$last" '
      $config + {
        monitors: $monitors,
        sinks: $sinks,
        themes: $themes,
        currentTheme: $theme,
        currentSink: $sink,
        lastSceneId: $last
      }'
}

validate_scene() {
  jq -ce '
    select(type == "object")
    | .name = ((.name // "") | tostring | gsub("^[[:space:]]+|[[:space:]]+$"; ""))
    | select((.name | length) >= 1 and (.name | length) <= 64)
    | .icon = (if ((.icon // "") | tostring | length) > 0 then (.icon | tostring) else "󰍹" end)
    | select((.icon | length) <= 4)
    | .id = (if ((.id // "") | length) > 0 then .id else "" end)
    | .theme = (if .theme == null or .theme == "" then null else (.theme | tostring) end)
    | select((.monitors | type) == "array" and (.monitors | length) > 0)
    | select(([.monitors[] | select(.primary == true)] | length) == 1)
    | select(([.monitors[].connector] | unique | length) == (.monitors | length))
    | select(all(.monitors[];
        . as $monitor
        | ((.connector // "") | length) > 0
        and ($monitor.scale == "auto" or (["1","1.25","1.6","2","3","4"] | index($monitor.scale | tostring)) != null)
        and ($monitor.primary == true or (["left","right","up","down"] | index($monitor.direction // "")) != null)
      ))
    | select(((.audio.name // "") | length) > 0)
    | {
        id, name, icon, theme,
        monitors: [.monitors[] | {
          connector: (.connector | tostring),
          description: ((.description // .connector) | tostring),
          primary: (.primary == true),
          scale: (.scale | tostring)
        } + (if .primary == true then {} else {direction: .direction} end)],
        audio: {
          name: (.audio.name | tostring),
          label: ((.audio.label // .audio.name) | tostring)
        }
      }
  ' <<<"$1" 2>/dev/null
}

save_command() {
  [[ $# -eq 1 ]] || { usage >&2; return 2; }
  with_lock

  local scene config id duplicate next
  scene=$(validate_scene "$1") || {
    echo "scene is invalid" >&2
    return 2
  }
  config=$(read_config)
  id=$(jq -r '.id' <<<"$scene")
  if [[ -z $id ]]; then
    id=$(< /proc/sys/kernel/random/uuid)
    scene=$(jq -c --arg id "$id" '.id = $id' <<<"$scene")
  fi

  duplicate=$(jq -r --arg id "$id" --arg name "$(jq -r '.name | ascii_downcase' <<<"$scene")" '
    [.scenes[] | select(.id != $id and (.name | ascii_downcase) == $name)] | length
  ' <<<"$config")
  (( duplicate == 0 )) || {
    echo "scene names must be unique" >&2
    return 2
  }

  next=$(jq -c --arg id "$id" --argjson scene "$scene" '
    if any(.scenes[]; .id == $id)
    then .scenes |= map(if .id == $id then $scene else . end)
    else .scenes += [$scene]
    end
  ' <<<"$config")
  write_json_atomic "$CONFIG_FILE" "$next"
  printf '%s\n' "$id"
}

delete_command() {
  [[ $# -eq 1 && -n $1 ]] || { usage >&2; return 2; }
  with_lock
  local config count next last
  config=$(read_config)
  count=$(jq --arg id "$1" '[.scenes[] | select(.id == $id)] | length' <<<"$config")
  (( count == 1 )) || { echo "scene not found: $1" >&2; return 1; }
  next=$(jq -c --arg id "$1" '.scenes |= map(select(.id != $id))' <<<"$config")
  write_json_atomic "$CONFIG_FILE" "$next"
  last=$(read_last_scene)
  if [[ $last == "$1" ]]; then
    write_json_atomic "$STATE_FILE" '{"lastSceneId":""}'
  fi
}

resolve_monitors() {
  local scene="$1" inventory="$2"
  jq -ce --argjson inventory "$inventory" '
    .monitors |= map(
      . as $saved
      | ([ $inventory[] | select(.connector == $saved.connector) ] | if length == 1 then .[0] else null end) as $byConnector
      | ([ $inventory[] | select(.description == $saved.description) ] | if length == 1 then .[0] else null end) as $byDescription
      | ($byConnector // $byDescription) as $match
      | . + {resolvedConnector: ($match.connector // "")}
    )
  ' <<<"$scene"
}

lua_quote() {
  jq -Rrn --arg value "$1" '$value | @json'
}

configure_monitor() {
  local connector="$1" mode="$2" position="$3" scale="$4"
  local output_lua mode_lua position_lua
  output_lua=$(lua_quote "$connector")
  mode_lua=$(lua_quote "$mode")
  position_lua=$(lua_quote "$position")
  "$HYPRCTL_BIN" eval "hl.monitor({ output = $output_lua, mode = $mode_lua, position = $position_lua, scale = $scale, disabled = false })"
}

disable_monitor() {
  local output_lua
  output_lua=$(lua_quote "$1")
  "$HYPRCTL_BIN" eval "hl.monitor({ output = $output_lua, disabled = true })"
}

focus_workspace() {
  local workspace_lua
  workspace_lua=$(lua_quote "$1")
  "$HYPRCTL_BIN" eval "hl.dispatch(hl.dsp.focus({ workspace = $workspace_lua }))"
}

move_workspace_to_monitor() {
  local workspace_lua monitor_lua
  workspace_lua=$(lua_quote "$1")
  monitor_lua=$(lua_quote "$2")
  "$HYPRCTL_BIN" eval "hl.dispatch(hl.dsp.workspace.move({ workspace = $workspace_lua, monitor = $monitor_lua }))"
}

restore_monitors() {
  local snapshot="$1" current row connector mode position scale
  current=$(monitor_inventory 2>/dev/null || printf '[]')
  while IFS= read -r row; do
    connector=$(jq -r '.connector' <<<"$row")
    if [[ $(jq -r '.enabled' <<<"$row") == true ]]; then
      mode=$(jq -r '(.width|tostring)+"x"+(.height|tostring)+"@"+(.refreshRate|tostring)' <<<"$row")
      position=$(jq -r '(.x|tostring)+"x"+(.y|tostring)' <<<"$row")
      scale=$(jq -r '.scale' <<<"$row")
      configure_monitor "$connector" "$mode" "$position" "$scale" >/dev/null 2>&1 || true
    else
      disable_monitor "$connector" >/dev/null 2>&1 || true
    fi
  done < <(jq -c '.[]' <<<"$snapshot")

  while IFS= read -r connector; do
    if ! jq -e --arg name "$connector" 'any(.[]; .connector == $name)' <<<"$snapshot" >/dev/null; then
      disable_monitor "$connector" >/dev/null 2>&1 || true
    fi
  done < <(jq -r '.[].connector' <<<"$current")
}

wait_for_scene_monitors() {
  local resolved="$1" active
  for _ in {1..30}; do
    active=$("$HYPRCTL_BIN" monitors -j 2>/dev/null || printf '[]')
    if jq -e --argjson active "$active" '
      all(.monitors[]; .resolvedConnector as $name | any($active[]; .name == $name))
    ' <<<"$resolved" >/dev/null; then
      return 0
    fi
    sleep 0.1
  done
  return 1
}

apply_audio() {
  local sink_name="$1" sinks device_prefix sink_row sink_id resolved_name
  device_prefix="${sink_name%.*}."
  for _ in {1..30}; do
    sinks=$(sink_inventory 2>/dev/null || printf '[]')
    sink_row=$(jq -r --arg name "$sink_name" --arg prefix "$device_prefix" '
      ([.[] | select(.name == $name)] | if length == 1 then .[0] else null end)
      // ([.[] | select(.name | startswith($prefix))] | if length == 1 then .[0] else null end)
      // {}
      | [(.id // ""), (.name // "")] | @tsv
    ' <<<"$sinks")
    IFS=$'\t' read -r sink_id resolved_name <<<"$sink_row"
    if [[ -n $sink_id ]]; then
      "$AUDIO_SET_BIN" "$sink_id" "$resolved_name" >/dev/null
      return 0
    fi
    sleep 0.1
  done
  return 1
}

apply_scene() {
  local scene="$1" inventory resolved missing theme current snapshot row connector position scale primary selected live active_workspace sink_name
  inventory=$(monitor_inventory)
  resolved=$(resolve_monitors "$scene" "$inventory")
  missing=$(jq -r '[.monitors[] | select(.resolvedConnector == "") | .description] | join(", ")' <<<"$resolved")
  if [[ -n $missing ]]; then
    notify "Missing display: $missing"
    echo "missing display: $missing" >&2
    return 1
  fi

  theme=$(jq -r '.theme // ""' <<<"$resolved")
  if [[ -n $theme ]]; then
    if ! theme_inventory | jq -e --arg wanted "$(slugify "$theme")" 'any(.[]; (ascii_downcase | gsub("[[:space:]]+"; "-")) == $wanted)' >/dev/null; then
      notify "Theme is not installed: $theme"
      echo "theme is not installed: $theme" >&2
      return 1
    fi
  fi

  snapshot="$inventory"
  active_workspace=$("$HYPRCTL_BIN" activeworkspace -j | jq -r '.name // ""')
  current=$(current_theme)
  if [[ -n $theme && $(slugify "$theme") != "$(slugify "$current")" ]]; then
    if ! "$OMARCHY_BIN" theme set "$theme" >/dev/null; then
      notify "Could not apply theme $theme"
      echo "could not apply theme: $theme" >&2
      return 1
    fi
    inventory=$(monitor_inventory)
    resolved=$(resolve_monitors "$scene" "$inventory")
    missing=$(jq -r '[.monitors[] | select(.resolvedConnector == "") | .description] | join(", ")' <<<"$resolved")
    if [[ -n $missing ]]; then
      restore_monitors "$snapshot"
      notify "A display disappeared during the theme change; restored the previous layout"
      return 1
    fi
  fi

  while IFS= read -r row; do
    connector=$(jq -r '.resolvedConnector' <<<"$row")
    scale=$(jq -r '.scale' <<<"$row")
    if ! configure_monitor "$connector" "preferred" "auto-right" "$scale" >/dev/null; then
      restore_monitors "$snapshot"
      notify "Could not enable $connector; restored the previous layout"
      return 1
    fi
  done < <(jq -c '.monitors[]' <<<"$resolved")

  if ! wait_for_scene_monitors "$resolved"; then
    restore_monitors "$snapshot"
    notify "Displays did not become ready; restored the previous layout"
    return 1
  fi

  primary=$(jq -r '.monitors[] | select(.primary == true) | .resolvedConnector' <<<"$resolved")
  [[ -z $active_workspace ]] || move_workspace_to_monitor "$active_workspace" "$primary" >/dev/null || true

  selected=$(jq -c '[.monitors[].resolvedConnector]' <<<"$resolved")
  live=$(monitor_inventory)
  while IFS= read -r connector; do
    if ! jq -e --arg name "$connector" 'index($name) != null' <<<"$selected" >/dev/null; then
      disable_monitor "$connector" >/dev/null || true
    fi
  done < <(jq -r '.[] | select(.enabled) | .connector' <<<"$live")

  while IFS= read -r row; do
    connector=$(jq -r '.resolvedConnector' <<<"$row")
    scale=$(jq -r '.scale' <<<"$row")
    if [[ $(jq -r '.primary' <<<"$row") == true ]]; then
      position="0x0"
      primary="$connector"
    else
      position="auto-$(jq -r '.direction' <<<"$row")"
    fi
    if ! configure_monitor "$connector" "preferred" "$position" "$scale" >/dev/null; then
      restore_monitors "$snapshot"
      notify "Could not enable $connector; restored the previous layout"
      return 1
    fi
  done < <(jq -c '(.monitors[] | select(.primary == true)), (.monitors[] | select(.primary != true))' <<<"$resolved")

  if ! wait_for_scene_monitors "$resolved"; then
    restore_monitors "$snapshot"
    notify "Displays did not settle; restored the previous layout"
    return 1
  fi
  [[ -z $active_workspace ]] || focus_workspace "$active_workspace" >/dev/null || true

  write_json_atomic "$STATE_FILE" "$(jq -cn --arg id "$(jq -r '.id' <<<"$scene")" '{lastSceneId:$id}')"

  sink_name=$(jq -r '.audio.name' <<<"$scene")
  if ! apply_audio "$sink_name"; then
    notify "Scene applied, but audio output is unavailable"
    return 3
  fi

  notify "Switched to $(jq -r '.name' <<<"$scene")"
}

apply_command() {
  [[ $# -eq 1 && -n $1 ]] || { usage >&2; return 2; }
  with_lock
  local config scene
  config=$(read_config)
  scene=$(jq -ce --arg id "$1" '.scenes[] | select(.id == $id)' <<<"$config") || {
    echo "scene not found: $1" >&2
    return 1
  }
  apply_scene "$scene"
}

next_command() {
  with_lock
  local config count last next_index scene
  config=$(read_config)
  count=$(jq '.scenes | length' <<<"$config")
  if (( count == 0 )); then
    notify "No scenes configured"
    return 1
  fi
  last=$(read_last_scene)
  next_index=$(jq -r --arg id "$last" '
    ([.scenes[].id] | index($id)) as $index
    | if $index == null then 0 else (($index + 1) % (.scenes | length)) end
  ' <<<"$config")
  scene=$(jq -c --argjson index "$next_index" '.scenes[$index]' <<<"$config")
  apply_scene "$scene"
}

command_name="${1:-}"
[[ $# -gt 0 ]] && shift
case "$command_name" in
  status) status_command "$@" ;;
  save) save_command "$@" ;;
  delete) delete_command "$@" ;;
  apply) apply_command "$@" ;;
  next) next_command "$@" ;;
  -h|--help|help) usage ;;
  *) usage >&2; exit 2 ;;
esac
